--  Tell the Ada runtime not to install signal handlers that turn Unix
--  signals into Ada exceptions. Ada runtime only attempts to install
--  handlers for signals 4, 6, 7, 8, and 11.
pragma Interrupt_State ( 1,  System);
pragma Interrupt_State ( 2,  System);
pragma Interrupt_State ( 3,  System);
pragma Interrupt_State ( 4,  System);
pragma Interrupt_State ( 5,  System);
pragma Interrupt_State ( 6,  System);
pragma Interrupt_State ( 7,  System);
pragma Interrupt_State ( 8,  System);
pragma Interrupt_State ( 9,  System);
pragma Interrupt_State (10,  System);
pragma Interrupt_State (11,  System);
