[
  {
    "kind": "Project",
    "name": "Test",
    "attributes": {
      "Target": "aarch64-nto-qnx",
      "Runtime": {
        "Ada": "runtime/aarch64_qnx_runtime/latest"
      },
      "Toolchain_Name": {
        "C": "QNX_QCC_VER_12_2_0",
        "C++": "QNX_QCC_VER_12_2_0"
      },
      "Languages": [
        "ada",
        "c"
      ],
      "Main": [
        "potato.adb"
      ]
    },
    "packages": {
      "Builder": {
        "kind": "Package",
        "name": "Builder",
        "attributes": {
          "Global_Configuration_Pragmas": "global_config_pragmas_qnx.adc",
          "Executable": {
            "potato.adb": "potato"
          },
          "Switches": {
            "others": [
              "-we",
              "-s",
              "-q"
            ]
          }
        }
      },
      "Binder": {
        "kind": "Package",
        "name": "Binder",
        "attributes": {
          "Switches": {
            "potato.adb": [
              "-shared"
            ]
          },
          "Bindfile_Option_Substitution": {
            "-shared": [
              ""
            ]
          }
        }
      },
      "Compiler": {
        "kind": "Package",
        "name": "Compiler",
        "attributes": {
          "Default_Switches": {
            "C": [
              "-I/POTATO/blah",
              "-fstack-protector-strong",
              "-march=armv8.2-a",
              "-O2",
              "-fno-aggressive-loop-optimizations",
              "-fno-omit-frame-pointer",
              "-Wredundant-decls",
              "-fno-builtin",
              "-fno-builtin-libm",
              "-mbranch-protection=pac-ret+leaf",
              "-Werror",
              "-Wall",
              "-Wformat",
              "-Wchar-subscripts",
              "-Wparentheses",
              "-Wtrigraphs",
              "-Wpointer-arith",
              "-Wmissing-declarations",
              "-Wmain",
              "-Wreturn-type",
              "-Wmultichar",
              "-Wunused",
              "-Wmissing-braces",
              "-Wstrict-aliasing",
              "-Wsign-compare",
              "-Waddress",
              "-Wstringop-truncation",
              "-Wif-not-aligned",
              "-Wrestrict",
              "-Wmissing-attributes",
              "-Wpacked-not-aligned",
              "-fPIC",
              "-DPIC",
              "-Wno-error=sign-compare",
              "-Wno-error=array-bounds",
              "-Wno-error=redundant-decls",
              "-Wno-error=enum-compare",
              "-Wno-error=strict-aliasing",
              "-Wno-error=unused-but-set-variable",
              "-Wno-error=stringop-truncation",
              "-Wno-error=stringop-overflow",
              "-Wno-error=format-truncation",
              "-Wno-error=maybe-uninitialized",
              "-Wno-error=duplicate-decl-specifier",
              "-Wno-error=format-overflow",
              "-Wno-error=unused-const-variable",
              "-Wno-error=parentheses",
              "-Wno-error=incompatible-pointer-types",
              "-Wno-error=packed-not-aligned",
              "-Wno-error=missing-braces",
              "-Wno-error=missing-prototypes",
              "-Wno-error=deprecated-declarations",
              "-Wno-error=format",
              "-Wno-error=aligned-new=",
              "-Wno-error=restrict",
              "-Wno-error=address",
              "-Wno-error=address-of-packed-member",
              "-Wno-error=cpp",
              "-Wno-error=format-extra-args",
              "-Wno-error=narrowing",
              "-Wno-error=pessimizing-move",
              "-Wno-error=range-loop-construct",
              "-Wno-error=return-local-addr",
              "-Wno-error=unused-variable",
              "-DNDEBUG",
              "-g",
              "-D_FORTIFY_SOURCE=2",
              "-DCOMPONENT_NAME=potato",
              "-Wimplicit",
              "-Wmissing-prototypes",
              "-Wpointer-sign",
              "-Wstrict-prototypes",
              "-Wno-error=implicit-function-declaration"
            ],
            "C++": [
              "-std=c++17",
              "-nostdinc",
              "-nostdinc++",
              "-D_NO_EX",
              "-Wno-error=class-memaccess",
              "-Wno-error=catch-value",
              "-I/POTATO/blah",
              "-fstack-protector-strong",
              "-march=armv8.2-a",
              "-O2",
              "-fno-aggressive-loop-optimizations",
              "-fno-omit-frame-pointer",
