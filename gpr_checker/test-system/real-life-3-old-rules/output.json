              "-Wpointer-arith",
              "-Wmissing-declarations",
              "-Wmain",
              "-Wreturn-type",
              "-Wmultichar",
              "-Wunused",
              "-Wmissing-braces",
              "-Wstrict-aliasing",
              "-Wsign-compare",
              "-Waddress",
              "-Wstringop-truncation",
              "-Wif-not-aligned",
              "-Wrestrict",
              "-Wmissing-attributes",
              "-Wpacked-not-aligned",
              "-fPIC",
              "-DPIC",
              "-Wno-error=sign-compare",
              "-Wno-error=array-bounds",
              "-Wno-error=redundant-decls",
              "-Wno-error=enum-compare",
              "-Wno-error=strict-aliasing",
              "-Wno-error=unused-but-set-variable",
              "-Wno-error=stringop-truncation",
              "-Wno-error=stringop-overflow",
              "-Wno-error=format-truncation",
              "-Wno-error=maybe-uninitialized",
              "-Wno-error=duplicate-decl-specifier",
              "-Wno-error=format-overflow",
              "-Wno-error=unused-const-variable",
              "-Wno-error=parentheses",
              "-Wno-error=incompatible-pointer-types",
              "-Wno-error=packed-not-aligned",
              "-Wno-error=missing-braces",
              "-Wno-error=missing-prototypes",
              "-Wno-error=deprecated-declarations",
              "-Wno-error=format",
              "-Wno-error=aligned-new=",
              "-Wno-error=restrict",
              "-Wno-error=address",
              "-Wno-error=address-of-packed-member",
              "-Wno-error=cpp",
              "-Wno-error=format-extra-args",
              "-Wno-error=narrowing",
              "-Wno-error=pessimizing-move",
              "-Wno-error=range-loop-construct",
              "-Wno-error=return-local-addr",
              "-Wno-error=unused-variable",
              "-DNDEBUG",
              "-g",
              "-D_FORTIFY_SOURCE=2",
              "-DCOMPONENT_NAME=potato"
            ],
            "Ada": [
              "-Wall",
              "-gnat2022",
              "-gnatwa",
              "-gnatw.w",
              "-gnatw.X",
              "-gnatw.d",
              "-gnatw.h",
              "-gnatw.k",
              "-gnatwl",
              "-gnatw.o",
              "-gnatw_r",
              "-gnatw.s",
              "-gnatwt",
              "-Werror",
              "-gnatwe",
              "-gnatw.j",
              "-gnatwh",
              "-fcallgraph-info=su,da",
              "-gnatyr",
              "-fstack-protector-strong",
              "-Os",
              "-gnatp",
              "-gnatyy",
              "-gnatyM95",
              "-fPIC"
            ]
          },
          "Local_Configuration_Pragmas": "spark.adc"
        }
      },
      "Analyzer": {
        "kind": "Package",
        "name": "Analyzer",
        "attributes": {
          "Switches": {
            "inspector": [
              "-gnatd.I"
            ]
          }
        }
      },
      "Check": {
        "kind": "Package",
        "name": "Check",
        "attributes": {
          "Default_Switches": {
            "Ada": [
              "--show-rule",
              "--check-redefinition",
              "-rules",
              "-from=gnatcheck-rules.txt",
              "-from=gnatcheck-rules-safety.txt"
            ]
          }
        }
      },
      "Prove": {
        "kind": "Package",
        "name": "Prove",
        "attributes": {
          "Proof_Switches": {
            "Ada": [
              "-j0",
              "--info",
              "--mode=all",
              "--prover=altergo,cvc5,z3",
              "--warnings=error",
              "--checks-as-errors=on",
              "-U",
              "--timeout=1200",
              "--memlimit=0",
              "--quiet",
              "--timeout=15",
              "--level=1"
            ]
          }
        }
      }
    }
  }
