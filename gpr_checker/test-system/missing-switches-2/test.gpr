project Test is

   package Compiler is
      for Default_Switches ("C") use ("-O2");
      for Switches ("potato.adb") use ("-O3");
      for Switches ("Ada") use ("-gnatyy");
   end Compiler;

   package Prove is
      for Proof_Switches("potato.adb") use ("--prover=cvc5,colibri");
   end Prove;

end Test;
